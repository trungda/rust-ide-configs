{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dark+ (Cursor)",
  "author": "tdinh",
  "themes": [
    {
      "name": "Dark+ (Cursor)",
      "appearance": "dark",
      "style": {
        "background": "#1e1e1e",
        "border": "#2b2b2b",
        "border.variant": "#2b2b2b",
        "border.focused": "#007fd4",
        "elevated_surface.background": "#252526",
        "surface.background": "#252526",
        "panel.background": "#252526",
        "text": "#cccccc",
        "text.muted": "#9d9d9d",
        "text.placeholder": "#6e6e6e",
        "text.accent": "#3794ff",
        "icon": "#c5c5c5",
        "icon.muted": "#8b8b8b",
        "element.background": "#2d2d2d",
        "element.hover": "#2a2d2e",
        "element.selected": "#37373d",
        "element.active": "#04395e",
        "ghost_element.hover": "#2a2d2e",
        "ghost_element.selected": "#37373d",
        "title_bar.background": "#1e1e1e",
        "title_bar.inactive_background": "#1e1e1e",
        "status_bar.background": "#2d2d2d",
        "tab_bar.background": "#252526",
        "tab.active_background": "#1e1e1e",
        "tab.inactive_background": "#2d2d2d",
        "toolbar.background": "#1e1e1e",
        "scrollbar.thumb.background": "#79797966",
        "scrollbar.thumb.hover_background": "#646464b3",
        "scrollbar.track.background": "#1e1e1e00",
        "editor.background": "#1e1e1e",
        "editor.foreground": "#d4d4d4",
        "editor.gutter.background": "#1e1e1e",
        "editor.subheader.background": "#252526",
        "editor.active_line.background": "#ffffff0a",
        "editor.line_number": "#858585",
        "editor.active_line_number": "#c6c6c6",
        "editor.wrap_guide": "#41414188",
        "editor.active_wrap_guide": "#41414188",
        "editor.indent_guide": "#404040",
        "editor.indent_guide_active": "#707070",
        "editor.document_highlight.read_background": "#575757b8",
        "editor.document_highlight.write_background": "#004972b8",
        "search.match_background": "#623315",
        "hint": "#ffffff75",
        "hint.background": "#00000000",
        "error": "#f14c4c",
        "warning": "#cca700",
        "info": "#3794ff",
        "success": "#89d185",
        "created": "#81b88b",
        "modified": "#e2c08d",
        "deleted": "#c74e39",
        "players": [
          {
            "cursor": "#aeafad",
            "selection": "#264f78",
            "background": "#aeafad"
          }
        ],
        "syntax": {
          "attribute": { "color": "#9cdcfe" },
          "boolean": { "color": "#569cd6" },
          "comment": { "color": "#6a9955" },
          "comment.doc": { "color": "#6a9955" },
          "constant": { "color": "#4fc1ff" },
          "constructor": { "color": "#4ec9b0" },
          "embedded": { "color": "#d4d4d4" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "color": "#569cd6", "font_weight": 700 },
          "enum": { "color": "#4ec9b0" },
          "function": { "color": "#dcdcaa" },
          "function.method": { "color": "#dcdcaa" },
          "keyword": { "color": "#569cd6" },
          "keyword.control": { "color": "#c586c0" },
          "label": { "color": "#c8c8c8" },
          "lifetime": { "color": "#11ddcc" },
          "link_text": { "color": "#3794ff" },
          "link_uri": { "color": "#3794ff" },
          "number": { "color": "#b5cea8" },
          "operator": { "color": "#d4d4d4" },
          "preproc": { "color": "#c586c0" },
          "primary": { "color": "#d4d4d4" },
          "property": { "color": "#9cdcfe" },
          "punctuation": { "color": "#d4d4d4" },
          "punctuation.bracket": { "color": "#d4d4d4" },
          "punctuation.delimiter": { "color": "#d4d4d4" },
          "punctuation.list_marker": { "color": "#6796e6" },
          "punctuation.special": { "color": "#569cd6" },
          "string": { "color": "#ce9178" },
          "string.escape": { "color": "#d7ba7d" },
          "string.regex": { "color": "#d16969" },
          "string.special": { "color": "#d7ba7d" },
          "tag": { "color": "#569cd6" },
          "title": { "color": "#569cd6", "font_weight": 700 },
          "type": { "color": "#4ec9b0" },
          "type.builtin": { "color": "#4ec9b0" },
          "variable": { "color": "#9cdcfe" },
          "variable.special": { "color": "#569cd6" },
          "variant": { "color": "#4fc1ff" }
        }
      }
    }
  ]
}
